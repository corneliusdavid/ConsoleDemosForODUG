    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="ConsoleOut">
        <MSBuild Projects="QuickConsole\ConsoleOut\ConsoleOut.dproj"/>
    </Target>
    <Target Name="ConsoleOut:Clean">
        <MSBuild Projects="QuickConsole\ConsoleOut\ConsoleOut.dproj" Targets="Clean"/>
    </Target>
    <Target Name="ConsoleOut:Make">
        <MSBuild Projects="QuickConsole\ConsoleOut\ConsoleOut.dproj" Targets="Make"/>
    </Target>
    <Target Name="QuickConsoleMenu">
        <MSBuild Projects="QuickConsole\ConsoleMenu\QuickConsoleMenu.dproj"/>
    </Target>
    <Target Name="QuickConsoleMenu:Clean">
        <MSBuild Projects="QuickConsole\ConsoleMenu\QuickConsoleMenu.dproj" Targets="Clean"/>
    </Target>
    <Target Name="QuickConsoleMenu:Make">
        <MSBuild Projects="QuickConsole\ConsoleMenu\QuickConsoleMenu.dproj" Targets="Make"/>
    </Target>
    <Target Name="ConsoleDemo">
        <MSBuild Projects="Consoles\ConsoleDemo.dproj"/>
    </Target>
    <Target Name="ConsoleDemo:Clean">
        <MSBuild Projects="Consoles\ConsoleDemo.dproj" Targets="Clean"/>
    </Target>
    <Target Name="ConsoleDemo:Make">
        <MSBuild Projects="Consoles\ConsoleDemo.dproj" Targets="Make"/>
    </Target>
    <Target Name="Testbed">
